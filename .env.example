# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://acm_user:acm_password@localhost:5432/acm_competition
DB_HOST=localhost
DB_PORT=5432
DB_NAME=acm_competition
DB_USER=acm_user
DB_PASSWORD=acm_password

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-very-long-random-secret-string-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=change-this-refresh-secret-too
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── OTP ─────────────────────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6
# Set to "true" in development to print OTP to console instead of sending email
OTP_DEV_MODE=true

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@acm-nmamit.com

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_MAX=5

# ─── Code Execution Sandbox ──────────────────────────────────────────────────
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MEMORY_LIMIT_MB=256
